<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">


    <group
        android:scaleY="0.8"
        android:translateY="10"
        android:scaleX="0.8"
        android:translateX="10">

        <!-- Transparent background; logo kept inside the adaptive-icon safe area. -->
        <!-- Curved connecting line -->
        <path
            android:pathData="M20,72 C31,66 43,57 54,45 C66,31 77,24 94,21"
            android:strokeWidth="1.7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:strokeColor="#FFDF43" />

        <!-- Endpoint -->
        <path
            android:pathData="M94,19.1 A1.9,1.9 0,1 0,94.01 19.1 Z"
            android:fillColor="#FFDF43" />

        <!-- Main sphere -->
        <path
            android:pathData="M20,67 A13.5,13.5 0,1 0,20.01 67 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="16"
                    android:centerY="63"
                    android:gradientRadius="19">
                    <item android:color="#FFFFA52E" android:offset="0.0" />
                    <item android:color="#FFFFD94A" android:offset="0.48" />
                    <item android:color="#FFB88320" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
